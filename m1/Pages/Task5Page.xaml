<Page x:Class="m1.Pages.Task5Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:m1.Pages"
      mc:Ignorable="d"
      Title="Task5Page"  Height="800" Width="1000"
        MinHeight="700" MinWidth="900">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Purple">
            <Image Width="45" Height="45" HorizontalAlignment="Left" Margin="5"/>
            <TextBlock Text="Задание 5" Foreground="White"
                       FontSize="22" FontWeight="Bold"
                       HorizontalAlignment="Left" VerticalAlignment="Center"
                       Margin="60,0,0,0"/>
            <Button x:Name="btnBack" Content="Назад"
                    HorizontalAlignment="Right" VerticalAlignment="Center"
                    Width="90" Height="34" Margin="0,0,10,0"
                    FontSize="15" Background="#FFCFCACA"
                    BorderBrush="Black" BorderThickness="1"
                    Click="btnBack_Click"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">

                <TextBlock TextWrapping="Wrap" FontSize="16" Margin="0,0,0,20"
                           Text="Сгенерировать массив M×N (числа от −10 до 10). Отсортировать по возрастанию и убыванию. Найти min и max."/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="Строк N:" VerticalAlignment="Center"
                               FontSize="15" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtRows" Width="60" Height="32"
                             FontSize="15" Margin="0,0,15,0"/>

                    <TextBlock Text="Столбцов M:" VerticalAlignment="Center"
                               FontSize="15" Margin="0,0,5,0"/>
                    <TextBox x:Name="txtCols" Width="60" Height="32" FontSize="15"/>
                </StackPanel>

                <Button x:Name="btnGenerate" Content="Сгенерировать и отсортировать"
                        Width="280" Height="38" HorizontalAlignment="Left"
                        FontSize="15" Background="#FFBDA8C9"
                        BorderBrush="Black" BorderThickness="1"
                        Margin="0,0,0,20" Click="btnGenerate_Click"/>

                <TextBlock Text="Исходный массив:" FontSize="15" FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="txtOriginal" Height="120" IsReadOnly="True"
                         TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="13" Margin="0,0,0,15"/>

                <TextBlock Text="По возрастанию:" FontSize="15" FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="txtAsc" Height="120" IsReadOnly="True"
                         TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="13" Margin="0,0,0,15"/>

                <TextBlock Text="По убыванию:" FontSize="15" FontWeight="Bold"
                           Margin="0,0,0,5"/>
                <TextBox x:Name="txtDesc" Height="120" IsReadOnly="True"
                         TextWrapping="NoWrap" AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas" FontSize="13" Margin="0,0,0,15"/>

                <TextBlock x:Name="txtMinMax" FontSize="15" FontWeight="Bold"
                           Margin="0,0,0,10"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>