<Window x:Class="m1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:m1"
        mc:Ignorable="d"
        Title="Практика — Вариант 2" Height="800" Width="1000" MinHeight="700" MinWidth="900">
    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="Purple">
            <Image Width="45" Height="45" HorizontalAlignment="Left" Margin="5"/>
        </Grid>

        <Frame x:Name="FrmMain" Grid.Row="1" NavigationUIVisibility="Hidden" Background="White"/>

        <StackPanel x:Name="pnlMenu" Grid.Row="1"
                    VerticalAlignment="Center" HorizontalAlignment="Center">

            <TextBlock Text="Вариант 2" FontSize="28" FontWeight="Bold"
                       HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <Button x:Name="btnTask1" Content="Задание 1" Width="220" Height="42"
                    FontSize="16" Margin="0,0,0,12" Background="#FFBDA8C9"
                    BorderBrush="Black" BorderThickness="2"
                    Click="btnTask1_Click"/>

            <Button x:Name="btnTask2" Content="Задание 2" Width="220" Height="42"
                    FontSize="16" Margin="0,0,0,12" Background="#FFBDA8C9"
                    BorderBrush="Black" BorderThickness="2"
                    Click="btnTask2_Click"/>

            <Button x:Name="btnTask3" Content="Задание 3" Width="220" Height="42"
                    FontSize="16" Margin="0,0,0,12" Background="#FFBDA8C9"
                    BorderBrush="Black" BorderThickness="2"
                    Click="btnTask3_Click"/>

            <Button x:Name="btnTask4" Content="Задание 4" Width="220" Height="42"
                    FontSize="16" Margin="0,0,0,12" Background="#FFBDA8C9"
                    BorderBrush="Black" BorderThickness="2"
                    Click="btnTask4_Click"/>

            <Button x:Name="btnTask5" Content="Задание 5" Width="220" Height="42"
                    FontSize="16" Background="#FFBDA8C9"
                    BorderBrush="Black" BorderThickness="2"
                    Click="btnTask5_Click"/>
        </StackPanel>
    </Grid>
</Window>